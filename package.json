{
  "name": "shepherd",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build:contracts": "forge build --root contracts && node scripts/export-bytecode.mjs",
    "test:contracts": "forge test --root contracts -vv",
    "demo": "tsx apps/agent/src/cli.ts demo",
    "agent": "tsx apps/agent/src/cli.ts",
    "mcp": "tsx apps/mcp/src/index.ts",
    "test:scope": "tsx apps/mcp/src/scope.test.ts",
    "dev": "vite --config apps/web/vite.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p apps/agent/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/mcp/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anon-rpc/browser-harness": "0.4.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@forshtat/hegota-support": "0.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@noble/curves": "^1.9.7",
    "@walletconnect/ethereum-provider": "^2.26.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.69.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "viem": "^2.38.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
