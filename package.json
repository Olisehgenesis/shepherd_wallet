{
  "name": "shepherd",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build:contracts": "forge build --root contracts && node scripts/export-bytecode.mjs",
    "test:contracts": "forge test --root contracts -vv",
    "demo": "tsx apps/agent/src/cli.ts demo",
    "agent": "tsx apps/agent/src/cli.ts",
    "dev": "vite --config apps/web/vite.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p apps/agent/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anon-rpc/browser-harness": "0.4.0",
    "@forshtat/hegota-support": "0.0.1",
    "@noble/curves": "^1.9.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.38.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
